{
  "name": "ted",
  "version": "0.2.3",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "node scripts/net-probe.mjs && tsc --noEmit -p tsconfig.json && tsc --noEmit -p packages/app/tsconfig.json",
    "lint": "biome check . && oxlint && ! git grep --untracked -nE '(oxlint|eslint)-(disable|enable)' -- '*.ts' '*.tsx' ':!tools/oxlint/anti-slop'",
    "format": "oxlint --fix && biome check --write .",
    "test": "vitest run",
    "ted": "node packages/cli/src/main.ts",
    "app": "pnpm --filter @ted/app start",
    "package": "pnpm --filter @ted/app package",
    "check": "node scripts/check.ts",
    "test-waits": "node scripts/test-waits.ts",
    "test-failures": "node scripts/test-failures.ts",
    "flaky": "node scripts/flaky.ts",
    "release": "node scripts/release.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.6",
    "@oxlint/plugins": "1.94.0",
    "@types/node": "^24.19.2",
    "oxlint": "1.94.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
